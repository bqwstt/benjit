algorithm is_prime(n) is
    if n < 2 then
        return false
    end

    variable i := 2
    for i * i < n + 1 do
        variable divided := n // i
        variable remainder := n - divided * i
        if remainder == 0 then
            return false
        end
        i := i + 1
    end

    return true
end

algorithm count_primes(limit) is
    variable count := 0
    variable n := 2
    for n < limit + 1 do
        if is_prime(n) then
            count := count + 1
        end
        n := n + 1
    end
    return count
end

variable result := count_primes(50)
print(result)